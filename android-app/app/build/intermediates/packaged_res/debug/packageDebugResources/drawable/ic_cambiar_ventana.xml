<?xml version="1.0" encoding="utf-8"?>
<!--
    Convertido del SVG "ejemplo1.svg" (icono de cambiar entre ventanas / task
    view: dos cuadrados con flechas saliendo de las esquinas). El SVG original
    solo tenia trazos (sin relleno), asi que cada figura se paso a un <path>
    con strokeColor/strokeWidth en vez de fillColor, manteniendo el mismo
    viewport (640x640) para que las coordenadas calcen igual.

    El color del trazo (strokeColor) queda fijo en el TEXTO_PRIMARIO del modo
    oscuro de la app (#EAEAEA) para que se vea igual que el texto de los
    demas botones de la grilla.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="640"
    android:viewportHeight="640">

    <!-- Cuadrado grande exterior -->
    <path
        android:pathData="M64.329361,63.150726 h513.62488 v513.62488 h-513.62488 Z"
        android:fillColor="#00000000"
        android:strokeColor="#EAEAEA"
        android:strokeWidth="40"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Cuadrado chico interior -->
    <path
        android:pathData="M196.14192,200.35556 h241.03101 v241.03101 h-241.03101 Z"
        android:fillColor="#00000000"
        android:strokeColor="#EAEAEA"
        android:strokeWidth="40"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Flecha esquina superior derecha -->
    <path
        android:pathData="M436.09576,204.7256 L568.10313,72.718232"
        android:fillColor="#00000000"
        android:strokeColor="#EAEAEA"
        android:strokeWidth="40"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Flecha esquina inferior derecha -->
    <path
        android:pathData="M567.00737,566.00737 L435,434"
        android:fillColor="#00000000"
        android:strokeColor="#EAEAEA"
        android:strokeWidth="40"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Flecha esquina superior izquierda -->
    <path
        android:pathData="M203.73849,204.72537 L71.73112,72.718"
        android:fillColor="#00000000"
        android:strokeColor="#EAEAEA"
        android:strokeWidth="40"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Flecha esquina inferior izquierda -->
    <path
        android:pathData="M65,577.00737 L197.00737,445"
        android:fillColor="#00000000"
        android:strokeColor="#EAEAEA"
        android:strokeWidth="40"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

</vector>
