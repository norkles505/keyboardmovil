<?xml version="1.0" encoding="utf-8"?>
<!--
    Convertido del SVG del usuario (triangulo de play + 2 barras de pausa,
    combo play/pausa). Icono de relleno solido, se pasa directo como
    fillColor. Mismo viewport (16x16) que el SVG original para que las
    coordenadas del pathData calcen igual.

    El color de relleno queda fijo en el TEXTO_PRIMARIO del modo oscuro de la
    app (#EAEAEA), igual que el resto de los iconos de la grilla.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="16"
    android:viewportHeight="16">

    <path
        android:pathData="M1 14H3L9 8L3 2H1V14Z"
        android:fillColor="#EAEAEA" />

    <path
        android:pathData="M15 2H13V14H15V2Z"
        android:fillColor="#EAEAEA" />

    <path
        android:pathData="M9 2H11V14H9V2Z"
        android:fillColor="#EAEAEA" />

</vector>
