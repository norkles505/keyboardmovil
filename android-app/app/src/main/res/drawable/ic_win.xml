<?xml version="1.0" encoding="utf-8"?>
<!--
    Convertido del SVG del logo de Windows (4 paneles) provisto por el
    usuario para la tecla F6,C2. El SVG original tenia los 4 paneles
    rellenos en negro con stroke tambien negro; aca se pasan a fillColor
    EAEAEA (TEXTO_PRIMARIO del modo oscuro de la app) sin stroke, para que
    se vea igual que los demas iconos de la grilla. Mismo viewport (500x500)
    que el SVG original para que las coordenadas calcen igual.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="500"
    android:viewportHeight="500">

    <!-- Panel superior izquierdo -->
    <path
        android:pathData="M 50.786675,108.68891 209.65781,86.551125 V 239.79559 L 50.786675,239.00448 Z"
        android:fillColor="#EAEAEA" />

    <!-- Panel superior derecho -->
    <path
        android:pathData="M 236.78269,82.572332 449.65382,52.434552 V 235.67901 l -212.87113,1.20889 z"
        android:fillColor="#EAEAEA" />

    <!-- Panel inferior izquierdo -->
    <path
        android:pathData="m 49,263.13771 158.87113,1.86222 V 416.24439 L 51,393.45328 Z"
        android:fillColor="#EAEAEA" />

    <!-- Panel inferior derecho -->
    <path
        android:pathData="m 235,265.1377 212.87113,1.86222 V 450.24438 L 235,419.45327 Z"
        android:fillColor="#EAEAEA" />

</vector>
