
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>windows_agent</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Necesario para System.Drawing (capturar y comprimir la pantalla como JPEG) -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <!-- Necesario para BrightnessController: acceso a WMI (root\WMI,
         WmiMonitorBrightness/WmiMonitorBrightnessMethods) para leer y
         ajustar el brillo de la pantalla. -->
    <PackageReference Include="System.Management" Version="8.0.0" />
    <!-- Necesario para generar el QR de conexion (IP+puerto+PIN) que se
         muestra en la consola al arrancar el agente. -->
    <PackageReference Include="QRCoder" Version="1.4.3" />
  </ItemGroup>

</Project>
